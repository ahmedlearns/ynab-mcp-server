# Copy to .env (gitignored) and fill in. Used by compose.yaml.

# YNAB personal access token: https://app.ynab.com/settings/developer
YNAB_API_TOKEN=

# Public HTTPS URL the server is reached at, without /mcp
YNAB_MCP_BASE_URL=https://ynab.example.com

# GitHub OAuth app (https://github.com/settings/developers). Its
# "Authorization callback URL" must be YNAB_MCP_BASE_URL + /auth/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated numeric GitHub user IDs allowed to sign in.
# Find yours with: gh api user --jq .id
GITHUB_ALLOWED_USER_IDS=

# Docker network your cloudflared container is on: docker network ls
TUNNEL_NETWORK=
